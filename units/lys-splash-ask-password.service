[Unit]
Description=Forward password requests to lys-splash
Documentation=https://systemd.io/PASSWORD_AGENTS/
DefaultDependencies=no
After=lys-splash-start.service
Before=shutdown.target
Conflicts=shutdown.target systemd-ask-password-plymouth.service
ConditionKernelCommandLine=!plymouth.enable=0
ConditionPathExists=/run/plymouth/pid
ConditionVirtualization=!container

[Service]
ExecStart=@systemd_tty_ask_password_agent@ --watch --plymouth
