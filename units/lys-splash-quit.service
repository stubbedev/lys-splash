[Unit]
Description=Quit the lys-splash boot splash
After=rc-local.service lys-splash-start.service systemd-user-sessions.service
Conflicts=plymouth-quit.service
ConditionKernelCommandLine=!plymouth.enable=0

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutSec=20
ExecStart=-@lys_splash@ quit

[Install]
WantedBy=multi-user.target
