[Unit]
Description=Show the lys-splash reboot splash
DefaultDependencies=no
After=getty@tty1.service display-manager.service lys-splash-start.service
Before=systemd-reboot.service
Conflicts=plymouth-reboot.service
@kernel_command_line_conditions@
ConditionVirtualization=!container

[Service]
Type=notify
ExecStart=@lys_splash@ --mode=reboot
ExecStartPost=-@lys_splash@ show-splash
RemainAfterExit=yes

[Install]
WantedBy=reboot.target
