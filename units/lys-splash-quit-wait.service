[Unit]
Description=Hold logins until the lys-splash boot splash quits
Wants=getty-pre.target
After=rc-local.service lys-splash-start.service systemd-user-sessions.service
Before=getty-pre.target
Conflicts=plymouth-quit-wait.service
ConditionKernelCommandLine=!plymouth.enable=0

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutSec=0
ExecStart=-@lys_splash@ --wait

[Install]
WantedBy=multi-user.target
