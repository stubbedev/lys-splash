[Unit]
Description=Forward password requests to lys-splash, directory watch
Documentation=https://systemd.io/PASSWORD_AGENTS/
DefaultDependencies=no
After=lys-splash-start.service
Before=basic.target shutdown.target
Conflicts=shutdown.target systemd-ask-password-plymouth.path
@kernel_command_line_conditions@
ConditionPathExists=/run/plymouth/pid
ConditionVirtualization=!container

[Path]
DirectoryNotEmpty=/run/systemd/ask-password
MakeDirectory=yes

[Install]
WantedBy=sysinit.target
