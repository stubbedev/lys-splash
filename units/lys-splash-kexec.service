[Unit]
Description=Show the lys-splash kexec reboot splash
DefaultDependencies=no
After=getty@tty1.service display-manager.service lys-splash-start.service
Before=systemd-kexec.service
Conflicts=plymouth-kexec.service
@kernel_command_line_conditions@
ConditionVirtualization=!container

[Service]
Type=notify
ExecStart=@lys_splash@ --mode=kexec
ExecStartPost=-@lys_splash@ show-splash
RemainAfterExit=yes

[Install]
WantedBy=kexec.target
