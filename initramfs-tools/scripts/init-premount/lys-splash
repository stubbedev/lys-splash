#!/bin/sh

PREREQ="udev"

prereqs()
{
	echo "${PREREQ}"
}

case ${1} in
	prereqs)
		prereqs
		exit 0
		;;
esac

SPLASH="false"

for ARGUMENT in $(cat /proc/cmdline)
do
	case "${ARGUMENT}" in
		nosplash|nosplash=*|plymouth.enable=0|splash=verbose)
			exit 0
			;;

		splash|splash=*|rhgb)
			SPLASH="true"
			;;
	esac
done

if [ "${SPLASH}" = "true" ]
then
	mkdir -p /run/plymouth
	chmod 0755 /run/plymouth
	/usr/sbin/plymouthd --mode=boot --attach-to-session --pid-file=/run/plymouth/pid
	/usr/bin/plymouth --show-splash
fi
